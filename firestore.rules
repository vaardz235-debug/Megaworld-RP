rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper: signed in
    function isSignedIn() { return request.auth != null; }

    // Helper: is owner of profile
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Placeholder Admin check (needs adjustment to actual admin strategy)
    function isAdmin() { return isSignedIn() && request.auth.token.email == "vaardz235@gmail.com"; }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /players/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /gameModes/{modeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /marketplace_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /game_servers/{serverId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /player_quests/{uid} {
      allow read, write: if isSignedIn();
    }

    match /ugc_creations/{creationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /ugc_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /player_progressions/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isSignedIn();
    }

    match /voice_moderation/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /sync_codes/{codeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /social_feed_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
  }
}
